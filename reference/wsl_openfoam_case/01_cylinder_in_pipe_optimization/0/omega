FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 390.2206927;	  // Omega = k^0.5 / (c_mu^0.25 * L), c_mu = 0.09

boundaryField
{
    bc_inlet
    {
        type            fixedValue;
        value           $internalField;
    }

    bc_outlet
    {
        type            zeroGradient;
    }

    "(wall.*)"
    {
        type            omegaWallFunction;
        value           $internalField;
    }


}


