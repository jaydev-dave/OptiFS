FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (16 0 0);

boundaryField
{
    bc_inlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0); // Initial guess for velocity
        inletValue      uniform (0 0 0); // Value to use during inflow

    }
    
    bc_outlet
    {
        type            flowRateOutletVelocity;
        massFlowRate    1.48; // Specify mass flow rate (kg/s) | 4500 m^3/h
        rhoOutlet       1.184;

    }

    "(wall.*)"
    {
        type            noSlip;
    }


}

